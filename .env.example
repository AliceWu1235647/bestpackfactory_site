# Required for secure on-demand ISR revalidation.
REVALIDATE_SECRET=replace-with-a-long-random-secret

# Public canonical URL and server-side origin allowlist.
# The production redirect currently makes www.bestpackfactory.com canonical.
NEXT_PUBLIC_SITE_URL=https://www.bestpackfactory.com
SITE_URL=https://www.bestpackfactory.com

# Canonical business identity used by content/deployment tooling.
# Existing static HTML is already generated with these values; changing them here alone does not rewrite that HTML.
WHATSAPP_NUMBER=8615886530985
COMPANY_NAME=BestPack Factory
COMPANY_NAME_CN=深圳市彩之印纸品包装有限公司

# Public Google Analytics 4 Measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=G-NY2MZYDQBL

# Optional: enable Cloudflare R2 product JSON as the live product data source.
# Use a public R2 bucket URL or a custom domain pointing to R2.
# Example: https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=

# R2 paths. With the default settings, product JSON should be uploaded to:
# ${R2_PUBLIC_BASE_URL}/products/{slug}.json
R2_PRODUCT_JSON_PREFIX=products
R2_PRODUCT_INDEX_PATH=products/index.json
R2_PRODUCT_REVALIDATE_SECONDS=3600

# Optional local testing: if true, the app can read r2-seed/products/{slug}.json locally.
USE_LOCAL_R2_SEED=false

# The frontend search boxes call /api/products-search, which merges static products with R2 products/index.json.
# No env var is needed for the endpoint; configure the R2 values above.

# Optional: enable Cloudflare R2 blog/news JSON as live content data sources.
# With the default settings, content JSON or HTML can be uploaded to:
# ${R2_PUBLIC_BASE_URL}/blog/{slug}.json
# ${R2_PUBLIC_BASE_URL}/blog/{slug}.html
# ${R2_PUBLIC_BASE_URL}/news/{slug}.json
# ${R2_PUBLIC_BASE_URL}/news/{slug}.html
R2_BLOG_JSON_PREFIX=blog
R2_BLOG_INDEX_PATH=blog/index.json
R2_NEWS_JSON_PREFIX=news
R2_NEWS_INDEX_PATH=news/index.json
R2_CONTENT_REVALIDATE_SECONDS=3600

# Hybrid structure note for Codex/Vercel deployments. The site works without R2 using static HTML fallback.
# When R2_PUBLIC_BASE_URL is configured, products/blog/news can be updated from R2 and refreshed through ISR.
HYBRID_STRUCTURE_NOTE=static-first-r2-isr

# AI customer-service workbench at /ai-inbox.
# Free local default: Ollama + DeepSeek R1. No API key is required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional paid fallback. Set AI_PROVIDER=openai to use these values.
# Keep the key server-side. Never expose it through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Required in production and whenever the service is shared over a LAN.
# Every operator enters the same value in the workbench or extension settings.
AI_WORKBENCH_ACCESS_TOKEN=replace-with-a-long-random-secret

# Contact form SMTP using SendGrid. Never commit the real API key.
# SMTP_USER must be the literal value "apikey"; SMTP_FROM must be a SendGrid-verified sender.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=apikey
SMTP_PASS=replace-with-sendgrid-api-key
SMTP_FROM=verified-sender@your-domain.com
# CONTACT_EMAIL is also accepted as a backwards-compatible alias.
CONTACT_TO_EMAIL=lisa@colorprintingpackage.com

# Optional alias. CONTACT_TO_EMAIL takes precedence when both are set.
CONTACT_EMAIL=lisa@colorprintingpackage.com

# Vercel Web Analytics does not require another environment variable.
# Enable the feature for the project in Vercel when it is wanted.
