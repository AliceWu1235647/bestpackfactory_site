  },
  "dependencies": {
    "next": "15.5.21",
    "nodemailer": "^9.0.3",
    "openai": "^7.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
