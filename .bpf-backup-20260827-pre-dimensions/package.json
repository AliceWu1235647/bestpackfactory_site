    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "deploy:check": "node scripts/deploy.mjs --skip-install",
    "deploy:dry-run": "node scripts/deploy.mjs --prod --dry-run --skip-install",
    "deploy": "node scripts/deploy.mjs --prod --skip-install",
    "deploy:fresh": "node scripts/deploy.mjs --prod",
    "lint:links": "node scripts/check-links.mjs",
    "revalidate:example": "node scripts/revalidate-example.mjs",
    "export:r2-products": "node scripts/export-static-products-to-r2-json.mjs",
    "r2:health": "echo \"Deploy first, then open /api/r2-health on your Vercel domain\"",
    "export:r2-content": "node scripts/export-static-content-to-r2-json.mjs",
    "check:r2-content": "node scripts/check-r2-content-files.mjs",
    "check:codex": "npm run lint:links && npm run check:r2-content && npm run check:hybrid && npm run build",
    "build:codex": "npm run build",
    "check:hybrid": "node scripts/check-hybrid-structure.mjs",
    "check:extension": "node scripts/validate-chrome-extension.cjs",
    "test:ai:lan": "node scripts/smoke-test-ai-lan.cjs",
    "audit:content": "node scripts/audit-content-quality.cjs",
    "audit:seo": "node scripts/audit-growth-foundations.cjs",
    "seo:link-clusters": "node scripts/apply-internal-link-clusters.cjs",
